# Copy this file to .env.test for "npm test". Never commit .env.test
# Same as .env, but a separate database: tests create data that is never deleted.
# The database name must end in _test, or the tests refuse to run.
DATABASE_URL=postgresql://doc365:doc365_dev_password@localhost:5432/doc365_test
JWT_SECRET=change-this-to-a-long-random-string
PORT=4000

# Access windows (German ePA-style), in days
ACCESS_DAYS_TREATMENT=90
